// GymCoach - Database schema
// Single-user, weightlifting tracking and Claude AI coach.

generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                                @id @default(cuid())
  email             String                                @unique
  passwordHash      String
  // Bodyweight in kg, used to compute the effective tonnage on bodyweight
  // exercises (Set.weight = added load, always >= 0; the input schemas clamp
  // it). Null = not filled in yet, so no bodyweight bonus is applied
  // (backward-safe).
  bodyweight        Float?
  // Optional profile, used to tailor the AI coach output to the user.
  displayName       String?
  sex               Sex?
  heightCm          Int?
  goal              TrainingGoal?
  weeklyFrequency   Int?
  // Preferred weight unit for display and input. Data is always stored in kg;
  // this only affects the presentation layer. Default keeps existing users on kg.
  unit              WeightUnit                            @default(KG)
  // IANA zone for weeks, streaks and dates (a Sunday-night session stays on Sunday).
  timezone          String                                @default("America/Sao_Paulo")
  // End of the user's planned deload week (issue #112). While this timestamp
  // is in the future, load suggestions apply the planned-deload step-down.
  // Null or in the past = no planned deload (backward-safe additive column).
  deloadUntil       DateTime?
  // Free-text note the user writes to their AI coach (issue #188): their own
  // current context for the coach to weigh - injuries, illness, life
  // constraints ("shoulder is bothering me, go easy on pressing"). Input-side
  // only and correctable by the user. Null = no note (backward-safe additive
  // column); the set/clear route bounds it to 500 chars.
  coachNote         String?
  // Onboarding (spec §4): everything optional except what the user picks.
  // Self-declared experience; later partly inferred from history.
  experience            TrainingExperience?
  birthDate             DateTime?
  // Availability: minutes per session and preferred weekdays (0 = Sunday).
  sessionMinutes        Int?
  trainingDays          Int[]                 @default([])
  // "morning" | "afternoon" | "evening", free text kept short by the API.
  preferredTrainingTime String?
  priorityMuscles       MuscleGroup[]         @default([])
  // Set when the onboarding flow is completed (or skipped on purpose).
  onboardedAt           DateTime?
  exercisePreferences   ExercisePreference[]
  createdAt         DateTime                              @default(now())
  programs          Program[]
  sessions          Session[]
  exercises         Exercise[]
  conversations     Conversation[]
  readinessCheckins ReadinessCheckin[]
  exerciseGoals     ExerciseGoal[]
  bodyweightEntries BodyweightEntry[]
  bodyMeasurements  BodyMeasurement[]
  volumeTargets     VolumeTarget[]
  progressPhotos    ProgressPhoto[]
  gyms              Gym[]                                 @relation("GymOwner")
  mcpAccessTokens   McpAccessToken[]
  mcpBackfillAudits McpHistoricalEquipmentBackfillAudit[]
  authSessions      AuthSession[]
  passwordResets    PasswordResetToken[]
  trainingRecommendations TrainingRecommendation[]
  personalRecords         PersonalRecord[]
  activeGymId       String?
  activeGym         Gym?                                  @relation("ActiveGym", fields: [activeGymId], references: [id], onDelete: SetNull)
}

// Login session behind the signed session cookie (claim `sid`). Revoking a row
// (logout, "sign out other devices", password change) ends access on the next
// request: server components and API routes re-check it.
model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?

  @@index([userId, revokedAt])
}

// One-time password reset link sent by e-mail (lib/password-reset). Only a
// SHA-256 hash of the token is stored; it expires quickly, works once, and a
// new request replaces the user's earlier unused links.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId, usedAt])
}

// Personal access tokens for remote MCP clients such as ChatGPT. Only a
// SHA-256 hash is stored; the raw token is shown once when it is created.
model McpAccessToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  canWrite    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([userId, createdAt])
}

// Audit trail of MCP historical-equipment backfills: one row per confirmed
// apply, kept so a backfill can be listed and undone later. Gym, exercise,
// equipment and set references are plain scalar IDs on purpose - the audit must
// survive their deletion. Only the owning user is a real relation, so the rows
// go away with the account.
model McpHistoricalEquipmentBackfillAudit {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymId             String
  exerciseId        String
  equipmentId       String
  setIds            String[]
  equipmentSnapshot Json
  createdAt         DateTime  @default(now())
  undoneAt          DateTime?

  @@index([userId, createdAt])
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum WeightUnit {
  KG
  LB
}

enum TrainingGoal {
  HYPERTROPHY
  STRENGTH
  FAT_LOSS
  RECOMP
  GENERAL_FITNESS
  MAINTENANCE
  RETURN_TO_TRAINING
}

enum SetType {
  WARMUP
  WORKING
  DROP
  AMRAP
  FAILURE
  BACKOFF
  OTHER
}

enum TrainingExperience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExercisePreferenceKind {
  PREFER
  AVOID
}

// Exercises the user likes or wants to avoid (onboarding, AI planner input).
// AVOID is a preference or a self-reported limitation, never a diagnosis.
model ExercisePreference {
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise               @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  kind       ExercisePreferenceKind
  reason     String?
  createdAt  DateTime               @default(now())

  @@id([userId, exerciseId])
  @@index([exerciseId])
}

// Conversational AI coach: a thread of messages with the trainee.
model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId, updatedAt])
}

enum MessageRole {
  USER
  ASSISTANT
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// One table for both kinds of exercise:
// - global catalog (userId null): curated, shared, read-only for users,
//   identified by a stable `slug` and synced from data/catalog/*.json;
// - custom (userId set): private to its owner, never overrides a global one.
model Exercise {
  id                 String                 @id @default(cuid())
  userId             String?
  user               User?                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  name               String
  slug               String?                @unique
  namePtBr           String?
  muscleGroup        MuscleGroup
  category           ExerciseCategory
  movementPattern    MovementPattern?
  laterality         Laterality?
  level              ExerciseLevel?
  // Finer equipment tags than equipmentType (bench, smith_machine, ...).
  equipmentTags      String[]               @default([])
  instructionsPtBr   String[]               @default([])
  commonMistakesPtBr String[]               @default([])
  defaultRestSec     Int                    @default(90)
  notes              String?
  // For bodyweight exercises (pull-ups, dips, push-ups...): the effective
  // tonnage includes User.bodyweight. Set.weight remains the added load (0 by
  // default, always >= 0 - the input schemas clamp it; negative loads for
  // assistance machines are deliberately not supported, see issue #118).
  usesBodyweight     Boolean                @default(false)
  // Determines which saved-gym inventory constrains suggested loads.
  equipmentType      EquipmentType          @default(OTHER)
  // Provenance of catalog rows (license per row, ADR-005).
  source             String?
  sourceRef          String?
  sourceLicense      String?
  reviewStatus       String?
  // Hidden from pickers when false; history keeps pointing at it.
  active             Boolean                @default(true)
  createdAt          DateTime               @default(now())
  programExercises   ProgramExercise[]
  sets               Set[]
  goals              ExerciseGoal[]
  gymConfigs         GymExerciseConfig[]
  gymEquipmentLinks  GymEquipmentExercise[]
  aliases            ExerciseAlias[]
  muscles            ExerciseMuscle[]
  preferences        ExercisePreference[]

  @@unique([userId, name])
  @@index([userId, active])
}

enum MovementPattern {
  SQUAT
  HINGE
  HORIZONTAL_PUSH
  VERTICAL_PUSH
  HORIZONTAL_PULL
  VERTICAL_PULL
  KNEE_FLEXION
  KNEE_EXTENSION
  ELBOW_FLEXION
  ELBOW_EXTENSION
  SHOULDER_ABDUCTION
  CALF
  CORE
  CARRY
  ISOLATION
  CARDIO
}

enum Laterality {
  BILATERAL
  UNILATERAL
  ALTERNATING
}

enum ExerciseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MuscleRole {
  PRIMARY
  SECONDARY
  STABILIZER
}

// Anatomical muscles; slugs double as the ids of the body-map SVG.
model Muscle {
  id        String           @id @default(cuid())
  slug      String           @unique
  nameEn    String
  namePtBr  String
  group     MuscleGroup
  view      String
  exercises ExerciseMuscle[]
}

model ExerciseMuscle {
  exerciseId String
  exercise   Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleId   String
  muscle     Muscle     @relation(fields: [muscleId], references: [id], onDelete: Cascade)
  role       MuscleRole

  @@id([exerciseId, muscleId])
  @@index([muscleId])
}

// Search terms (pt-BR and English) and legacy names of catalog exercises.
// `normalized` is lower-case without accents, matched by the search.
model ExerciseAlias {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  alias      String
  normalized String
  locale     String
  // Exact name this exercise had in the per-user catalog (merge source).
  isLegacy   Boolean  @default(false)

  @@unique([exerciseId, normalized])
  @@index([normalized])
}

// Content hash of the last catalog sync, so a boot only rewrites the catalog
// when data/catalog changed.
model CatalogSync {
  id       String   @id
  version  Int
  hash     String
  syncedAt DateTime @default(now())
}

enum EquipmentType {
  DUMBBELL
  BARBELL
  MACHINE
  CABLE
  BODYWEIGHT
  CARDIO
  OTHER
}

enum MuscleGroup {
  CHEST
  BACK_WIDTH
  BACK_THICKNESS
  SHOULDERS_FRONT
  SHOULDERS_LATERAL
  SHOULDERS_REAR
  BICEPS
  TRICEPS
  FOREARMS
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  ABS
  LOWER_BACK
  // Fallback bucket for imported exercises that could not be classified
  // (issue #100). The user can re-categorize them afterwards.
  OTHER
}

enum ExerciseCategory {
  COMPOUND
  ISOLATION
  // Conditioning work (issue #133): running, rowing, cycling... Sets on a
  // CARDIO exercise are duration/distance based (durationSec required,
  // distanceM optional) and store reps = 1 / weight = 0 to keep the existing
  // NOT NULL columns untouched. They are excluded from tonnage/e1RM/PR math.
  CARDIO
}

model Program {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  name        String
  description String?
  phase       String
  // How the next workout is chosen (lib/next-workout): in sequence after the
  // last one done, or by the weekday set on each workout.
  scheduleMode ProgramSchedule @default(ROTATION)
  // Mesocycle (lib/program-cycle): the program repeats over cycleWeeks
  // calendar weeks counted from cycleAnchor (the Monday of week 1);
  // cycleDeloadWeek is run lighter. Null cycleWeeks = no cycle.
  cycleWeeks      Int?
  cycleDeloadWeek Int?
  cycleAnchor     DateTime?
  isActive    Boolean   @default(false)
  startDate   DateTime  @default(now())
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workouts    Workout[]
  sessions    Session[]
  revisions   ProgramRevision[]

  @@index([userId])
}

// Immutable versions of a program's structure (lib/program-revisions). Every
// write path records one after changing the program, workouts or
// prescriptions; a restore writes a new version with old content, so no
// version is ever destroyed. A burst of manual edits is coalesced into one
// version until a session runs with it.
model ProgramRevision {
  id          String                @id @default(cuid())
  programId   String
  program     Program               @relation(fields: [programId], references: [id], onDelete: Cascade)
  version     Int
  source      ProgramRevisionSource
  // Free-text note from the author (coach rationale, AI request), shown as is.
  summary     String?
  // Set on a RESTORE: the version whose content was brought back.
  restoredFromVersion Int?
  // ProgramSnapshot: program fields, workouts and prescriptions, with the
  // exercise names so the version stays readable after an exercise changes.
  snapshot    Json
  // SHA-256 of the snapshot content without row ids: a write that changes
  // nothing records nothing.
  contentHash String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  sessions    Session[]

  @@unique([programId, version])
}

enum ProgramSchedule {
  ROTATION
  FIXED_DAYS
}

enum ProgramRevisionSource {
  CREATED
  USER
  TEMPLATE
  AI_GENERATED
  COACH
  MCP
  IMPORT
  RESTORE
  SYSTEM
}

model Workout {
  id        String            @id @default(cuid())
  programId String
  program   Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  dayOfWeek Int?
  order     Int
  exercises ProgramExercise[]
  sessions  Session[]

  @@index([programId, order])
}

model ProgramExercise {
  id                 String                @id @default(cuid())
  workoutId          String
  workout            Workout               @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId         String
  exercise           Exercise              @relation(fields: [exerciseId], references: [id])
  order              Int
  targetSets         Int
  targetRepsMin      Int
  targetRepsMax      Int
  targetRIR          Int
  restSec            Int
  tempo              String?
  notes              String?
  // Superset pairing (issue #146, slice 1, additive): exercises of the same
  // workout sharing a group number form a superset; NULL = standalone. The
  // stored number is arbitrary - A1/A2 labels renumber on read (lib/supersets).
  supersetGroup      Int?
  // Intra-session set autoregulation. PRESERVE_RIR keeps effort stable and
  // lets reps drift; PRESERVE_REPS adjusts load to keep reps stable.
  autoregulationMode SetAutoregulationMode @default(PRESERVE_RIR)
  // Optional per-exercise overrides. Null delegates to deterministic defaults
  // derived from exercise category and muscle group.
  fatigueRate        Float?
  loadAdjustmentPct  Float?
  recommendations    TrainingRecommendation[]

  @@index([workoutId, order])
  @@index([exerciseId])
}

enum RecommendationAction {
  INCREASE
  HOLD
  DECREASE
  DELOAD
  INSUFFICIENT_DATA
}

// Next-load decision of the training engine for one prescription line, taken
// when a session starts (ADR-007, lib/training-recommendations): the action,
// the load, the reason, every input it used and the guideline version, so the
// decision can be audited and explained (also by the AI) later.
model TrainingRecommendation {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId         String
  session           Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // The prescription line; kept as history if the line is later removed.
  programExerciseId String?
  programExercise   ProgramExercise?     @relation(fields: [programExerciseId], references: [id], onDelete: SetNull)
  exerciseId        String
  action            RecommendationAction
  valueKg           Float?
  reason            String
  inputs            Json
  guidelineVersion  String
  createdAt         DateTime             @default(now())

  @@index([sessionId])
  @@index([userId, exerciseId, createdAt])
}

enum PersonalRecordType {
  WEIGHT
  REPS
  E1RM
  SET_VOLUME
  EXERCISE_VOLUME
  WORKOUT_TONNAGE
  WEEKLY_TONNAGE
}

// A record a finished session beat (epic 2.2, lib/personal-records), with
// the previous best, so the dashboard and the weekly report can say "Novo PR
// de e1RM no supino: 94 kg (antes 91)" without recomputing history.
model PersonalRecord {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Null for the workout and weekly tonnage records.
  exerciseId    String?
  type          PersonalRecordType
  value         Float
  previousValue Float
  // The set behind a set-level record (effective load in kg).
  weightKg      Float?
  reps          Int?
  achievedAt    DateTime
  createdAt     DateTime           @default(now())

  @@index([userId, achievedAt])
  @@index([sessionId])
}

enum SetAutoregulationMode {
  PRESERVE_RIR
  PRESERVE_REPS
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  programId  String?
  program    Program?  @relation(fields: [programId], references: [id])
  workoutId  String?
  workout    Workout?  @relation(fields: [workoutId], references: [id])
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  notes      String?
  // The gym is frozen when the session starts so later switching gyms does
  // not change the inventory used by an in-progress or historical workout.
  gymId      String?
  gym        Gym?      @relation(fields: [gymId], references: [id], onDelete: SetNull)
  // The program version the session ran (set at start): the plan as it was,
  // whatever edits came later.
  programRevisionId String?
  programRevision   ProgramRevision? @relation(fields: [programRevisionId], references: [id], onDelete: SetNull)
  // Exercises replaced only for this session (lib/session-swaps): a map of
  // ProgramExercise id -> Exercise id. The saved program does not change.
  exerciseSwaps Json?
  // Week of the program's cycle the session ran in (set at start), when the
  // program has one.
  cycleWeek     Int?
  sets       Set[]
  setTombstones SetTombstone[]
  recommendations TrainingRecommendation[]
  personalRecords PersonalRecord[]

  @@index([userId, startedAt])
  @@index([workoutId])
  @@index([programId])
  @@index([gymId])
  @@index([programRevisionId])
}

// A deleted set, remembered by the device key it was logged with (ADR-004).
// A late replay of its creation (lost response, another tab, a delete that
// overtook the create) is refused instead of bringing the set back.
model SetTombstone {
  id               String   @id @default(cuid())
  sessionId        String
  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientMutationId String
  deletedAt        DateTime @default(now())

  @@unique([sessionId, clientMutationId])
}

model Gym {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation("GymOwner", fields: [userId], references: [id], onDelete: Cascade)
  name            String
  // All inventory values are stored in kg, matching Set.weight.
  dumbbellWeights Float[]             @default([])
  plateWeights    Float[]             @default([])
  barWeights      Float[]             @default([])
  // Equipment categories this gym has (catalog equipment tags such as
  // barbell, smith_machine, cable, leg_press). Exercise selection and the AI
  // planner never pick an exercise that needs something missing here.
  availableEquipment String[]         @default([])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  activeForUsers  User[]              @relation("ActiveGym")
  sessions        Session[]
  exerciseConfigs GymExerciseConfig[]
  equipment       GymEquipment[]

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model GymExerciseConfig {
  id            String   @id @default(cuid())
  gymId         String
  gym           Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  isAvailable   Boolean  @default(true)
  // Optional explicit machine/cable pin stack or other exercise-specific
  // loads. Empty means use the normal category increment.
  weightOptions Float[]  @default([])

  @@unique([gymId, exerciseId])
  @@index([exerciseId])
}

model GymEquipment {
  id            String                 @id @default(cuid())
  gymId         String
  gym           Gym                    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name          String
  equipmentType EquipmentType
  description   String?
  manufacturer  String?
  modelName     String?
  quantity      Int                    @default(1)
  weightOptions Float[]                @default([])
  imageUrl      String?
  imageData     Bytes?
  imageMimeType String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  exerciseLinks GymEquipmentExercise[]
  performedSets Set[]

  @@unique([gymId, name])
  @@index([gymId, equipmentType])
}

model GymEquipmentExercise {
  equipmentId String
  equipment   GymEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([equipmentId, exerciseId])
  @@index([exerciseId])
}

model Set {
  id                    String        @id @default(cuid())
  sessionId             String
  session               Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId            String
  exercise              Exercise      @relation(fields: [exerciseId], references: [id])
  gymEquipmentId        String?
  gymEquipment          GymEquipment? @relation(fields: [gymEquipmentId], references: [id], onDelete: SetNull)
  equipmentNameSnapshot String?
  equipmentLoadSnapshot Json?
  setNumber             Int
  weight                Float
  reps                  Int
  rir                   Int?
  // Cardio sets (issue #133, additive): duration in seconds (>= 1 when set)
  // and optional distance in meters. NULL on strength sets - existing rows
  // are untouched and lifting flows never write these.
  durationSec           Int?
  distanceM             Float?
  // Average heart rate in bpm (issue #152, additive): the extra signal a TCX
  // file import carries over manual logging. 40..250 when present (enforced
  // by every writer), NULL on strength sets and on cardio logged without it.
  avgHr                 Int?
  // Maximum (peak) heart rate in bpm (issue #203, additive): the companion HR
  // metric watches record, carried in the same TCX exports. 40..250 when
  // present (enforced by every writer), NULL on strength sets and on cardio
  // logged without it.
  maxHr                 Int?
  // Downsampled pace/HR track of an imported cardio activity (issue #254,
  // additive): a JSON array of up to a few hundred points
  // [{ t, d?, hr? }] where t = seconds from the start, d = cumulative meters,
  // hr = bpm. NULL on strength sets and on cardio logged without a track.
  track                 Json?
  notes                 String?
  isWarmup              Boolean       @default(false)
  isDropSet             Boolean       @default(false)
  // Kind of set. isWarmup/isDropSet are kept in sync with it until every
  // reader uses `type` (expand phase): WARMUP <-> isWarmup, DROP <-> isDropSet.
  type                  SetType       @default(WORKING)
  // Optional effort on the RPE scale (6 to 10 in half steps), next to RIR.
  rpe                   Float?
  // The prescription in force when the set was logged, so "target x actual"
  // survives later edits of the program.
  targetRepsMin         Int?
  targetRepsMax         Int?
  targetRir             Int?
  // Bodyweight at log time on bodyweight exercises: a later weight change no
  // longer rewrites past effective loads, PRs and e1RM.
  bodyweightKgSnapshot  Float?
  completedAt           DateTime      @default(now())
  // Idempotency key from the offline queue (the client-side id of the set).
  // A retried POST with the same key returns the stored set instead of a
  // duplicate. Null for sets created before offline idempotency.
  clientMutationId      String?
  // When the server received the set. completedAt is when it was performed
  // (the device clock, bounded server-side), which differs for offline logs.
  receivedAt            DateTime      @default(now())

  @@unique([sessionId, clientMutationId])
  @@index([exerciseId, completedAt])
  // Leading on gymEquipmentId so the FK referential action (ON DELETE SET
  // NULL, executed by Postgres since relationMode is unset) can locate the
  // referencing rows without a full scan when equipment or a gym is deleted;
  // completedAt also serves per-equipment history queries (issue #325).
  @@index([gymEquipmentId, completedAt])
  @@index([sessionId, exerciseId])
}

// Per-exercise target goal (issue #90): a concrete "weight x reps" the user
// wants to reach, measured against the existing e1RM machinery (lib/goals.ts).
// Additive: one active goal per (user, exercise); creating a new one replaces
// it (upsert on the unique constraint). Weight is stored in kg like Set.weight;
// for bodyweight exercises it is the EFFECTIVE load (bodyweight + added load),
// consistent with lib/stats.ts effectiveWeight semantics.
model ExerciseGoal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  // Target load in kg (effective load for bodyweight exercises).
  targetWeight Float
  targetReps   Int
  createdAt    DateTime  @default(now())
  // Stamped server-side when a logged working set meets the target
  // (weight >= targetWeight and reps >= targetReps). Null = not achieved yet.
  achievedAt   DateTime?

  @@unique([userId, exerciseId])
}

// Per-muscle weekly volume targets (issue #211). Personalizes the MEV/MRV
// reference band the progress-page volume card classifies against: serious
// lifters individualize these landmarks. Additive and fully optional - one row
// per (userId, muscleGroup); the ABSENCE of a row falls back to the global
// defaults (WEEKLY_SETS_MEV / WEEKLY_SETS_MRV in lib/stats.ts), so existing
// users are unaffected. mev >= 1 and mrv > mev are enforced by the Zod input
// schema; the band stays a display-only heuristic and never feeds progression
// or coach logic.
model VolumeTarget {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscleGroup MuscleGroup
  // Minimum effective volume (sets/week) and maximum recoverable volume.
  mev         Int
  mrv         Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, muscleGroup])
}

// Bodyweight history (issue #99). Additive: User.bodyweight stays the single
// "current value" the rest of the app reads (effective load, coach payload);
// this table keeps the measurement history behind it. Logging an entry also
// updates User.bodyweight; deleting the newest entry re-syncs it to the new
// newest one (or leaves the profile value alone when no entries remain).
model BodyweightEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stored in kg like every weight in the schema; converted at the edges.
  weightKg   Float
  measuredAt DateTime @default(now())
  note       String?

  @@index([userId, measuredAt])
}

// Tape-measure body measurements (issue #202, additive): the recomp/hypertrophy
// companion to bodyweight tracking. Stored always in cm; the client converts
// from the display unit. One row per (site, time) measurement; nothing else in
// the app reads it, so the table is fully additive.
model BodyMeasurement {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  site       BodyMeasurementSite
  // Stored in centimeters; the client converts from cm/inches at the edge.
  valueCm    Float
  measuredAt DateTime            @default(now())
  note       String?

  @@index([userId, site, measuredAt])
}

enum BodyMeasurementSite {
  WAIST
  HIPS
  CHEST
  SHOULDERS
  NECK
  ARM_LEFT
  ARM_RIGHT
  FOREARM_LEFT
  FOREARM_RIGHT
  THIGH_LEFT
  THIGH_RIGHT
  CALF_LEFT
  CALF_RIGHT
}

// Progress photo metadata (issue #269, additive): the visual companion to
// bodyweight and tape-measure tracking. The image bytes live on the LOCAL
// filesystem (under UPLOADS_DIR, gitignored, never a public static path) and
// only this row's storagePath points at them; every read goes through an
// ownership-scoped API route. mimeType is the SNIFFED type (magic bytes, an
// allowlist of jpeg/png/webp), never the client-declared one.
model ProgressPhoto {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  takenAt     DateTime @default(now())
  // Path of the image file RELATIVE to the progress-photo storage dir
  // (<userId>/<photoId>.<ext>), so a relocated UPLOADS_DIR keeps working.
  storagePath String
  mimeType    String
  byteSize    Int
  note        String?
  createdAt   DateTime @default(now())

  @@index([userId, takenAt])
}

// Proof that an account was erased (LGPD), keeping nothing about the person:
// a one-way hash of the deleted user id, when, and how many rows of each kind
// were removed (lib/account-deletion).
model AccountDeletion {
  id          String   @id @default(cuid())
  subjectHash String   @unique
  deletedAt   DateTime @default(now())
  counts      Json
}

model CoachSession {
  id        String    @id @default(cuid())
  userId    String
  weekStart DateTime
  weekEnd   DateTime
  prompt    String    @db.Text
  response  String    @db.Text
  appliedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, weekStart])
}

// Pre-session readiness / soreness check-in (issue #38). Additive, optional:
// the app never requires a check-in, and the coach treats it as one more input
// signal for recovery-anchored auto-regulation. Soreness is stored per muscle
// group as a JSON map (group -> 1-5) so adding groups later needs no migration.
model ReadinessCheckin {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Overall readiness to train, 1 (drained) to 5 (primed).
  readiness    Int
  // Sleep quality the previous night, 1 (poor) to 5 (great).
  sleepQuality Int
  // Optional per-muscle-group soreness: { "QUADS": 4, "CHEST": 2, ... } on a
  // 1-5 scale. Stored as JSON to stay flexible without a schema change.
  soreness     Json?
  // Optional free-text note.
  note         String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

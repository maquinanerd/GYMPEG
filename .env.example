# ============================================================
# GymCoach - Environment variables
# ============================================================
# Copy this file to .env and fill in the values.
# .env is ignored by git (see .gitignore).

# --- Database ---
# Local dev: "db" is the docker-compose service name. If you run Postgres via
# docker compose but Next.js locally, use "localhost" instead of "db".
DATABASE_URL=postgresql://gymcoach:gymcoach_dev_pwd@localhost:5433/gymcoach

# Variables used by the docker-compose "db" service:
POSTGRES_USER=gymcoach
POSTGRES_PASSWORD=gymcoach_dev_pwd
POSTGRES_DB=gymcoach

# --- Authentication ---
# Generate 64 random chars: openssl rand -base64 48
JWT_SECRET=replace-me-with-openssl-rand-base64-48

# Who may create an account: "open", "allowlist" or "closed". Defaults to
# "open" in development and "allowlist" in production. In allowlist mode only
# the emails below (comma-separated) can sign up.
SIGNUP_MODE=open
SIGNUP_ALLOWED_EMAILS=

# Demo account created by the seed (password is hashed at seed time)
USER_EMAIL=you@example.com
USER_PASSWORD=change-me-immediately

# Public demo mode: when "true", the login page shows the demo credentials below
# with a one-click "Log in as demo" button. Leave unset for normal instances.
# These are NEXT_PUBLIC_* (exposed to the browser) so only use them on a public
# demo instance with throwaway credentials.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_EMAIL=demo@gymcoach.app
NEXT_PUBLIC_DEMO_PASSWORD=gymcoachdemo

# --- AI coach ---
# Choose the provider: "gemini" (default), "deepseek", "anthropic",
# "openrouter", "codex-lb" or "demo". AI_PROVIDER wins over the legacy
# LLM_PROVIDER name. "demo" returns canned responses with no API key, handy to
# try the AI screens.
AI_PROVIDER=gemini
# Optional second provider used after one controlled retry when the primary
# fails (rate limit, outage, bad key). Leave empty to disable.
AI_FALLBACK_PROVIDER=deepseek
# AI features switched off on this instance (comma separated): any of
# ai.workout_generation, ai.workout_adjustment, ai.weekly_review, ai.chat.
AI_FEATURES_DISABLED=
# Price in USD per million tokens of the primary model, for the estimated
# cost kept in AIUsage. Leave empty to record tokens only.
AI_COST_PER_MTOKEN_INPUT=
AI_COST_PER_MTOKEN_OUTPUT=

# Google Gemini (AI_PROVIDER=gemini). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# DeepSeek (AI_PROVIDER=deepseek). Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Option A: Anthropic API (used when AI_PROVIDER=anthropic)
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Defaults to claude-opus-4-7. Use claude-sonnet-4-6 or claude-haiku-4-5 to
# trade some quality for lower cost.
ANTHROPIC_MODEL=claude-opus-4-7

# Option B: OpenRouter (used when LLM_PROVIDER=openrouter)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Exact model id on OpenRouter (see https://openrouter.ai/models).
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Optional: minimum output token budget for every OpenRouter call. Required
# for reasoning models (e.g. z-ai/glm-5.3-flash): their thinking counts
# against max_tokens and the default per-call budgets truncate their answers.
# OPENROUTER_MAX_TOKENS=100000
# Optional: title/URL sent in the OpenRouter headers for attribution.
OPENROUTER_APP_NAME=GymCoach
OPENROUTER_APP_URL=http://localhost:3030

# Option C: codex-lb / OpenAI Responses-compatible endpoint
# Include the /v1 path in the base URL.
CODEX_LB_BASE_URL=http://127.0.0.1:8317/v1
CODEX_LB_API_KEY=
CODEX_LB_MODEL=gpt-5.6-sol

# --- App ---
NEXTAUTH_URL=http://localhost:3030
# Public origin used in links sent by e-mail (falls back to NEXTAUTH_URL).
APP_URL=

# --- Operations ---
# postgres: share the auth/import/AI rate limits between app instances
# (needed with more than one replica). Unset: per-process memory.
RATE_LIMIT_STORE=
# json: one JSON object per log line (the default in production).
LOG_FORMAT=

# --- Object storage (progress photos, ADR-006) ---
# s3: a private S3-compatible bucket (Cloudflare R2, AWS S3, MinIO).
# Unset: the local uploads directory (UPLOADS_DIR).
STORAGE_PROVIDER=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- E-mail (password reset) ---
# resend: Resend HTTP API (needs RESEND_API_KEY and EMAIL_FROM).
# log: prints messages to the server log (development only; refused in
# production). Unset: password reset by e-mail is reported as unavailable.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM="GYM Peg <no-reply@example.com>"
# Session cookies are Secure by default in production. Set this to "false"
# only when self-hosting over plain HTTP on a trusted network.
# SESSION_COOKIE_SECURE=false
# Public HTTPS origin used when generating ChatGPT connector URLs.
# Set this when NEXTAUTH_URL points to a LAN address behind a reverse proxy.
MCP_PUBLIC_URL=
# Optional MCP endpoint hardening (issue #287). Comma-separated exact-match
# allowlists; setting either enables DNS rebinding protection on the MCP
# transport. CORS keys off MCP_ALLOWED_ORIGINS alone: when it is set, CORS
# echoes only allowlisted origins instead of *; hosts-only keeps CORS at *.
# MCP_ALLOWED_ORIGINS=https://gym.example.com
# MCP_ALLOWED_HOSTS=gym.example.com,gym.example.com:3030
NODE_ENV=development
# Local dir for user uploads (progress-photo files); gitignored, back it up.
UPLOADS_DIR=./uploads
